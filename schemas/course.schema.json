{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Course",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "learningMode": {
      "enum": ["business", "life"]
    },
    "order": {
      "type": "integer",
      "minimum": 0
    },
    "enabled": {
      "type": "boolean"
    },
    "levels": {
      "type": "array",
      "items": {
        "enum": ["N5", "N4", "N3", "N2", "N1"]
      }
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "order": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": ["id", "title", "order"]
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "title",
    "description",
    "learningMode",
    "order",
    "enabled",
    "levels"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "learningMode": {
            "const": "life"
          }
        }
      },
      "then": {
        "properties": {
          "levels": {
            "minItems": 1,
            "type": "array"
          }
        }
      }
    }
  ]
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Lesson",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "unitId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "order": {
      "type": "integer",
      "minimum": 0
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "level": {
      "enum": ["N5", "N4", "N3", "N2"]
    },
    "kind": {
      "enum": ["scene", "preparation"]
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "background": {
          "type": "string",
          "minLength": 1
        },
        "channel": {
          "enum": ["in-person", "phone", "meeting", "email", "chat", "other"]
        },
        "tasks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "relationships": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["background", "channel", "tasks", "relationships"]
    },
    "learnerSpeakerId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "speakers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "voice": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "browserVoiceURI": {
                "type": "string",
                "minLength": 1
              },
              "voicevoxStyleId": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": []
          }
        },
        "required": ["id", "name", "role"]
      }
    },
    "dialogues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "variant": {
            "enum": ["main", "branch", "register"]
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
                },
                "speakerId": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
                },
                "ja": {
                  "type": "string",
                  "minLength": 1
                },
                "zh": {
                  "type": "string",
                  "minLength": 1
                },
                "reading": {
                  "type": "string",
                  "minLength": 1
                },
                "ttsText": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": ["id", "speakerId", "ja", "zh"]
            }
          }
        },
        "required": ["id", "title", "variant", "lines"]
      }
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": ["email", "message", "explanation", "list", "table", "pronunciation"]
          },
          "blocks": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "paragraph"
                    },
                    "ja": {
                      "type": "string",
                      "minLength": 1
                    },
                    "zh": {
                      "type": "string",
                      "minLength": 1
                    },
                    "reading": {
                      "type": "string",
                      "minLength": 1
                    },
                    "ttsText": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": ["type", "ja"]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "list"
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "ja": {
                            "type": "string",
                            "minLength": 1
                          },
                          "zh": {
                            "type": "string",
                            "minLength": 1
                          },
                          "ttsText": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": ["ja", "zh"]
                      }
                    }
                  },
                  "required": ["type", "items"]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "table"
                    },
                    "headers": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "rows": {
                      "type": "array",
                      "items": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "required": ["type", "headers", "rows"]
                }
              ]
            }
          },
          "asset": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["id", "title", "kind", "blocks"]
      }
    },
    "vocabulary": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "word": {
            "type": "string",
            "minLength": 1
          },
          "reading": {
            "type": "string",
            "minLength": 1
          },
          "meaning": {
            "type": "string",
            "minLength": 1
          },
          "usage": {
            "type": "string",
            "minLength": 1
          },
          "collocations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "examples": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "ja": {
                  "type": "string",
                  "minLength": 1
                },
                "zh": {
                  "type": "string",
                  "minLength": 1
                },
                "ttsText": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": ["ja", "zh"]
            }
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "dialogueId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
              },
              "lineId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
              }
            },
            "required": ["dialogueId", "lineId"]
          }
        },
        "required": ["id", "word", "reading", "meaning", "examples"]
      }
    },
    "expressions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "function": {
            "type": "string",
            "minLength": 1
          },
          "pattern": {
            "type": "string",
            "minLength": 1
          },
          "meaning": {
            "type": "string",
            "minLength": 1
          },
          "audience": {
            "type": "string",
            "minLength": 1
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "slots": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": ["key", "description"]
            }
          },
          "examples": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "ja": {
                  "type": "string",
                  "minLength": 1
                },
                "zh": {
                  "type": "string",
                  "minLength": 1
                },
                "ttsText": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": ["ja", "zh"]
            }
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "dialogueId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
              },
              "lineId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
              }
            },
            "required": ["dialogueId", "lineId"]
          }
        },
        "required": [
          "id",
          "function",
          "pattern",
          "meaning",
          "audience",
          "notes",
          "slots",
          "examples"
        ]
      }
    },
    "grammar": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "pattern": {
            "type": "string",
            "minLength": 1
          },
          "level": {
            "enum": ["N5", "N4", "N3", "N2"]
          },
          "meaning": {
            "type": "string",
            "minLength": 1
          },
          "connection": {
            "type": "string",
            "minLength": 1
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "examples": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "ja": {
                  "type": "string",
                  "minLength": 1
                },
                "zh": {
                  "type": "string",
                  "minLength": 1
                },
                "ttsText": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": ["ja", "zh"]
            }
          }
        },
        "required": ["id", "pattern", "meaning", "connection", "notes", "examples"]
      }
    },
    "shadowing": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "dialogueId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "lineIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
            }
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["id", "dialogueId", "prompt"]
      }
    },
    "homework": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "type": {
            "enum": ["oral", "written"]
          },
          "situation": {
            "type": "string",
            "minLength": 1
          },
          "knownInformation": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "tasks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "hints": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "functions": {
            "type": "array",
            "items": {
              "enum": ["report", "contact", "consult"]
            }
          },
          "answers": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "ja": {
                  "type": "string",
                  "minLength": 1
                },
                "zh": {
                  "type": "string",
                  "minLength": 1
                },
                "ttsText": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": ["ja"]
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "type",
          "situation",
          "knownInformation",
          "tasks",
          "requirements",
          "hints",
          "answers"
        ]
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https?://"
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["title"]
      }
    }
  },
  "required": ["schemaVersion", "id", "order", "title", "kind", "objectives"],
  "allOf": [
    {
      "if": {
        "required": ["dialogues"],
        "properties": {
          "dialogues": { "type": "array", "minItems": 1 }
        }
      },
      "then": {
        "required": ["learnerSpeakerId"],
        "properties": { "learnerSpeakerId": {} }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "scene"
          }
        }
      },
      "then": {
        "required": ["scene", "dialogues"],
        "properties": {
          "dialogues": {
            "minItems": 1,
            "type": "array"
          },
          "scene": {}
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "preparation"
          }
        }
      },
      "then": {
        "required": ["materials"],
        "properties": {
          "materials": {
            "minItems": 1,
            "type": "array"
          }
        }
      }
    }
  ]
}
